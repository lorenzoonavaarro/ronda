# Local Docker Postgres. The password matches docker-compose.yml.
# The API loads apps/api/.env first and does not override a variable that
# is already set, so the live DATABASE_URL belongs in apps/api/.env.
DATABASE_URL=postgresql://ronda_pj1y_user:tPbjY0rxL4dM6bNCuJqQPI2hMciF6vDY@dpg-dbpnabbncjis73eklpf0-a.oregon-postgres.render.com/ronda_pj1y

# Render Postgres replaces that value. In the Render dashboard open the
# database, copy the External Database URL, and set it as DATABASE_URL in
# apps/api/.env. Use the external URL from this machine. The internal URL
# only works when the API itself is running on Render in the same region.
# Sign-in is Clerk. The Next.js app reads its keys from apps/web/.env.local.
# The API verifies session tokens with CLERK_SECRET_KEY in apps/api/.env.
# CLERK_SECRET_KEY=
# DATABASE_URL=postgres://USER:PASSWORD@dpg-xxxx.region-postgres.render.com/DATABASE

WEB_ORIGIN=http://localhost:3001

# Sandbox Log in with PayPal. The return URL must be saved on the app
# under Apps & Credentials, with Log in with PayPal enabled.
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PayPal rejects the hostname localhost in this field. The API sends the
# browser back to WEB_ORIGIN after this return.
# PAYPAL_RETURN_URL=http://127.0.0.1:3000/paypal/callback
# Webhook id from the PayPal app. A capture stays unpaid until this is set
# and PayPal can reach POST /paypal/webhook.
# PAYPAL_WEBHOOK_ID=

# Treasurer agent. Server-side only. Uses the Astropods AI Gateway chat API.
# Create a gateway key in the Astropods account. The URL is the host only;
# the API appends /v1. ASTRO_GATEWAY_MODEL defaults to claude-haiku-4-5.
# ASTRO_GATEWAY_URL=
# ASTRO_GATEWAY_API_KEY=
# ASTRO_GATEWAY_MODEL=
