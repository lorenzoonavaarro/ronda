# Local only. Copy to .env. The password matches docker-compose.yml.
DATABASE_URL=postgres://ronda:ronda@127.0.0.1:5433/ronda
WEB_ORIGIN=http://localhost:3001

# Sandbox Log in with PayPal. The return URL must be saved on the app
# under Apps & Credentials, with Log in with PayPal enabled.
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PayPal rejects the hostname localhost in this field. The API sends the
# browser back to WEB_ORIGIN after this return.
# PAYPAL_RETURN_URL=http://127.0.0.1:3000/paypal/callback
# Webhook id from the PayPal app. A capture stays unpaid until this is set
# and PayPal can reach POST /paypal/webhook.
# PAYPAL_WEBHOOK_ID=
